# Server-only OpenMerge customer credentials.
# Create a key in OpenMerge Settings and never prefix it with NEXT_PUBLIC_.
OPENMERGE_API_KEY=
OPENMERGE_WORKSPACE_ID=

# Fail-closed public-demo boundary. Generate both secrets independently.
# The access key is entered by an approved tester; the session secret signs HttpOnly cookies.
OPENMERGE_DEMO_ACCESS_KEY=
OPENMERGE_DEMO_SESSION_SECRET=

# Every session and linked-account operation is pinned to this customer identifier.
# In a real application derive this from your authenticated user/session instead.
OPENMERGE_DEMO_END_USER_ORIGIN_ID=demo-customer-001

# Optional, 300-86400 seconds. Defaults to 8 hours.
OPENMERGE_DEMO_SESSION_SECONDS=28800

# Hosted OpenMerge control plane and Link widget.
OPENMERGE_API_URL=https://api.openmerge.dev
NEXT_PUBLIC_OPENMERGE_EMBED_URL=https://widgets.openmerge.dev

# Exact browser origin allowed on link tokens and state-changing demo requests.
OPENMERGE_APP_URL=http://localhost:3000
